    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/observability-hook.mjs\" codex", "timeout": 10 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/observability-hook.mjs\" codex", "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "node \"$(git rev-parse --show-toplevel)/scripts/observability-hook.mjs\" codex", "timeout": 10 } ] }
    ]
  }

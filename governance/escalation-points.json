{
 "schema_version": 1,
 "note": "Every point where the harness stops for a person, as checked against library commit 211efd0: its id, stage, command, path, trigger, the two roles told first and next, the wait, the severity, the fix and the source. The line numbers in `source` are those of that commit. The delivery lead is always the third step of the ladder, so no row repeats it. A point on the question path or on no path writes no line, and `escalation.mjs raise` refuses it. A role listed under `roles.dynamic` is resolved by the command at the stop and passed in with --route-first or --route-next. `alternative` is the second path of a point that can follow two (feature.contradiction, survey-repo.stopped, connect-jira.connection), and the line names the one taken. `upstream` lists what a re-run of a review cap must find changed before it gets new rounds, and `at` says where it is read: `branch` for an artefact not merged yet, `trunk` for a merged one, and `given` for the approved test commit that the command passes with --tests-commit. The paths, waits, triggers and stages are closed sets that escalation-record.mjs reads. An id is `<command>.<stop>`: the command where the harness stops, without its slash, then a short name for the stop, such as `dev-sprint.code-review-cap`. A reader finds the command from the id alone. An id is never renamed or used again, because the record names it. A new point takes a new name, and a retired point keeps its id.",
 "paths": {
  "question": {
   "wait": "none",
   "severity": null,
   "records": false,
   "meaning": "the command asks the runner and waits in the session; nothing is written"
  },
  "merge-waiting": {
   "wait": "same-working-day",
   "severity": "IMPORTANT",
   "records": true,
   "meaning": "a planned merge that waited too long"
  },
  "review-cap": {
   "wait": "same-working-day",
   "severity": "IMPORTANT",
   "records": true,
   "meaning": "the worker and the critic reached the cap without APPROVED"
  },
  "decision-owed": {
   "wait": "next-working-day",
   "severity": "IMPORTANT",
   "records": true,
   "meaning": "the work needs an answer that only a named role may give"
  },
  "check-cannot-run": {
   "wait": "same-working-day",
   "severity": "IMPORTANT",
   "records": true,
   "meaning": "a script exited 2, or a tool, login or file is missing"
  },
  "incident": {
   "wait": "sixty-minutes",
   "severity": "CRITICAL",
   "records": true,
   "meaning": "a working credential, live data, production data or candidate data in code, a survey or a finding"
  },
  "handover": {
   "wait": "standing-sweep",
   "severity": "SUGGESTION",
   "records": true,
   "meaning": "the run finishes and leaves one item that only a person can do"
  }
 },
 "waits": {
  "none": "no reminder",
  "sixty-minutes": "60 minutes, any hour",
  "same-working-day": "until the end of the working day the stop falls in, or 2 hours after it, whichever is later",
  "next-working-day": "until the end of the recipient's next working day",
  "standing-sweep": "at the next standing sweep"
 },
 "triggers": [
  "revision-cap",
  "blocking-clarification",
  "contradiction",
  "control-undefined",
  "cannot-verify",
  "incident",
  "handover",
  "gate-waiting"
 ],
 "stages": [
  "requirements",
  "backlog",
  "design",
  "build",
  "pr-review",
  "validation",
  "context-governance",
  "clarification-queue"
 ],
 "roles": {
  "dynamic": [
   "role in Routed to",
   "the role the engineer named",
   "owner role of the document",
   "owning role"
  ],
  "note": "Every other role is a name the hub maps to a person in docs/harness-decisions.md. `runner` is the person who ran the command."
 },
